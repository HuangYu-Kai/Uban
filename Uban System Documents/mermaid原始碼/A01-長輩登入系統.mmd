flowchart TD
  subgraph ROLE["長輩"]
    LS_S1["開始"]:::lbl
    ST_S1(("&nbsp;")):::term
    S1([開啟 App]):::act
    S2["出示 4 碼配對碼與 QR"]:::act
  end
  subgraph FE["長輩機 App"]
    A1["SplashScreen 讀取<br/>prefs: user_role / saved_role"]:::act
    A2{"本機已有<br/>elder_id？"}:::dec
    A3["IdentificationScreen<br/>選擇『我是長者』"]:::act
    A4["ElderPairingDisplayScreen<br/>輪詢 check_status"]:::act
    A5{"本機角色<br/>為監控機？"}:::dec
    A6(["進入 ElderScreen<br/>isCCTVMode = true"]):::act
    LE_A6["結束"]:::lbl
    EN_A6(("&nbsp;")):::term
    A7(["進入 ElderHomeScreen<br/>五分頁主畫面"]):::act
    LE_A7["結束"]:::lbl
    EN_A7(("&nbsp;")):::term
  end
  subgraph FE2["家屬機"]
    C1["輸入 4 碼或掃描 QR"]:::act
    E2["家屬產生 6 碼復原碼<br/>15 分鐘有效<br/>POST /verify_recovery"]:::act
  end
  subgraph BE["uban-api 後端"]
    B1["GET /api/user/status/{user_id}<br/>回傳權威 role"]:::act
    B2["POST /api/pairing/request_code<br/>產生 4 碼 · 10 分鐘有效"]:::act
    B3["POST /api/pairing/confirm"]:::act
    B4["建立 user_account_data<br/>elder_profile（4 碼 elder_id）<br/>family_elder_relationship"]:::act
    E1["配對碼作廢<br/>重新產碼"]:::act
  end

