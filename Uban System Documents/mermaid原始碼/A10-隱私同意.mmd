flowchart TD
  subgraph ROLE["使用者（長輩端與家屬端共用）"]
    ST_S1(("&nbsp;")):::term
    S1([首次啟動 App]):::act
    S2["詳閱隱私權政策"]:::act
    S3{"是否同意？"}:::dec
    S4(["進入後續流程"]):::act
    EN_S4(("&nbsp;")):::term
