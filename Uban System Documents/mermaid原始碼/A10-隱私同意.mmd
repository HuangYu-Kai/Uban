    EN_S5(("&nbsp;")):::term
  end
  subgraph FE["App"]
    A1["SplashScreen 讀取<br/>prefs: PrivacyPolicyScreen.prefsKey"]:::act
    A2{"已同意過？"}:::dec
    A3["_replaceWith(PrivacyPolicyScreen)"]:::act
    A4["渲染 privacy_policy_content<br/>影像・語音・向量化記憶<br/>GPS 與室內定位・健康數據"]:::act
