flowchart TD
  subgraph ROLE["長輩"]
    PAD_ROLE["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]:::pad
    S1(["聽到提醒"]):::act
    S2{"點選<br/>『我完成了』？"}:::dec
    S3(["回報完成"]):::act
    EN_S3(("●")):::endterm
    S4(["維持未完成<br/>不重複轟炸"]):::act
    EN_S4(("●")):::endterm
  end
  subgraph FE["長輩機 App"]
    PAD_FE["&nbsp;"]:::pad
    A1["ElderReminderManager<br/>接收 Socket 事件"]:::act
    A2["firebase_bg_handler<br/>接收 FCM"]:::act
