    W1["20 秒看門狗<br/>主動補拉"]:::act
    X(["忽略重複"]):::act
    EN_X(("●")):::endterm
  end
  subgraph BE["uban-api"]
    ST_B1(("&nbsp;")):::term
    B1(["check_remote_reminders_job<br/>每分鐘觸發<br/>（APScheduler 排程）"]):::act
    B2["掃描 remote_reminders"]:::act
    B3{"有到期<br/>提醒？"}:::dec
    B4["emit_threadsafe('remote-reminder')<br/>推 comm_elder_id 與 elder_id 房間"]:::act
    B5["發送 data-only FCM<br/>離線備援"]:::act
    C1["complete 回報提醒已完成"]:::act
  end

  ST_B1 --> B1
  B1 --> B2
  B2 --> B3
  B3 -->|"[否]"| B1
  B3 -->|"[是]"| B4
  B4 --> B5
  B4 --> A1
  B5 --> A2
  A1 --> A3
  A2 --> A6
  A6 -->|"[是]"| A3
  A6 -->|"[否]"| A5
  A5 --> S1
  A3 -->|"[是]"| X
  A3 -->|"[否]"| A4
  A4 --> S1
  S1 --> S2
  S2 -->|"[是]"| C1
  C1 --> S3
  S2 -->|"[否]"| S4
  W1 -.-> A1
  S3 --> EN_S3
  S4 --> EN_S4
  X --> EN_X
  %% 鎖住泳道順序：ELK 不照宣告順序排，沒有這條鏈後端會跑到最上面
  ROLE ~~~ FE ~~~ BE

  classDef pad  fill:none,stroke:none,color:#FFFFFF
  classDef act  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
  classDef dec  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
  classDef term fill:#000000,stroke:#000000,stroke-width:3px,color:#000000
  classDef endterm fill:#FFFFFF,stroke:#000000,stroke-width:3px,color:#000000
  classDef gap  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000,stroke-dasharray:4 3
