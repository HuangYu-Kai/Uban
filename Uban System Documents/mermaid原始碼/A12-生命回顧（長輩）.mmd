%%{init:{"layout":"elk","elk":{"mergeEdges":false,"nodePlacementStrategy":"NETWORK_SIMPLEX"},"flowchart":{"htmlLabels":true},"themeVariables":{"clusterBkg":"#FFFFFF","clusterBorder":"#000000","edgeLabelBackground":"#FFFFFF","textColor":"#000000","nodeTextColor":"#000000","titleColor":"#000000","lineColor":"#000000","fontSize":"24px"}}}%%
flowchart TD
  subgraph ROLE["長輩"]
    PAD_ROLE["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]:::pad
    ST_S1(("&nbsp;")):::term
    S1([於『我的』分頁看到提問橫幅]):::act
    S2["點選橫幅開始述說"]:::act
    S3["錄音並輸入文字"]:::act
    S4(["故事存入本機"]):::act
    EN_S4(("●")):::endterm
  end
  subgraph FE["長輩機 App"]
    A1["ElderStoryPromptBanner<br/>MemoirService 題庫輪播"]:::act
    A2["ElderShareStoryDialog 長輩口述故事彈窗"]:::act
    A3["record 錄音"]:::act
    A4["組成 MemoirStory 物件"]:::act
    A5["過濾示範假資料 memoir_00*<br/>並回寫清理結果"]:::act
    A6{"JSON 解析<br/>成功？"}:::dec
    A7["回傳空清單<br/>記錄 debug 訊息"]:::act
    LOCAL[("SharedPreferences<br/>鍵：uban_memoirs_{elderId}<br/>★ 僅存於本機，無後端")]:::gap
    G1["家屬機藝廊讀的是<br/>家屬機自己的本機儲存<br/>→ 看不到長輩錄的內容"]:::act
    EN_G1(("●")):::endterm
    G2["清除資料或換機<br/>→ 故事永久遺失"]:::gap
  end

  ST_S1 --> S1
  S1 --> A1
  A1 --> S2
  S2 --> A2
  A2 --> S3
  S3 --> A3
  A3 --> A4
  A4 --> LOCAL
  LOCAL --> S4
  LOCAL --> A6
  A6 -->|"[是]"| A5
  A5 --> A1
  A6 -->|"[否]"| A7
  A7 --> A1
  LOCAL -.-> G1
  LOCAL -.-> G2
  S4 --> EN_S4
  G1 --> EN_G1
