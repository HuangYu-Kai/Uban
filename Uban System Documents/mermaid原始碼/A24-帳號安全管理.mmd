  DB --> B2
  ENV --- B2
  B2 --> B3
  B3 -->|"[否]"| A2
  B3 -->|"[是]"| S2
  S2 --> S3
  S3 -->|"[否]"| E1
  S3 -->|"[是]"| S4
  S4 --> B4
