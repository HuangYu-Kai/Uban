  ST_S1 --> S1
  ST_U1 --> U1
  U1 -.-> DB
  S1 --> G0
  G0 -->|"[否]"| X
  G0 -->|"[是]"| B1
  B1 -.-> DB
  B1 --> A1
  A1 --> S2
  S2 --> S3
  S3 -->|"[處理中]"| P1
  S3 -->|"[已修復]"| P2
  S3 -->|"[不予處理]"| P3
  P1 --> A2
  P2 --> A2
  P3 --> A2
  A2 --> B2
  B2 --> B3
  B3 -->|"[否]"| B4
  B3 -->|"[是]"| B5
  B5 -.-> DB
  B5 --> S4
  S4 --> M_END
  B4 --> M_END
  X --> M_END
  M_END --> EN_ALL
  ROLE ~~~ ROLE2 ~~~ FE ~~~ BE
  classDef pad  fill:none,stroke:none,color:#FFFFFF
  classDef act  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
  classDef dec  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
  classDef term fill:#000000,stroke:#000000,stroke-width:3px,color:#000000
  classDef endterm fill:#FFFFFF,stroke:#000000,stroke-width:3px,color:#000000
  classDef gap  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000,stroke-dasharray:4 3