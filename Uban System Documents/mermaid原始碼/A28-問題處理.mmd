    DB[("問題回報資料表")]:::gap
  end
  subgraph FE["開發者管理端（BUG 回饋頁）"]
    PAD_FE["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]:::pad
    A1["顯示回報清單"]:::act
    A2["填寫處理備註與變更狀態"]:::act
  end
  subgraph BE["uban-api 後端"]
    G0{"開發者身分<br/>驗證通過？"}:::dec
    B1["查詢 BUG 回報清單"]:::act
    B2["更新處理狀態與備註"]:::act
    B3{"狀態值<br/>是否在白名單內？"}:::dec
    B4["拒絕不合法的狀態"]:::act
    B5["更新狀態、備註與處理人"]:::act
    X(["401 未授權，擋下請求"]):::act
