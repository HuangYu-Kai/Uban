%%{init:{"layout":"elk","elk":{"mergeEdges":false},"flowchart":{"htmlLabels":true},"themeVariables":{"clusterBkg":"#FFFFFF","clusterBorder":"#000000","edgeLabelBackground":"#FFFFFF","textColor":"#000000","nodeTextColor":"#000000","titleColor":"#000000","lineColor":"#000000","fontSize":"24px"}}}%%
flowchart TD
  subgraph ROLE["開發者"]
    LS_S1["開始"]:::lbl
    ST_S1(("&nbsp;")):::term
    S1([進入『BUG 回饋』頁]):::act
    S2["檢視內容・裝置資訊・App 版本"]:::act
    S3{"判定結果？"}:::dec
    S4(["結案"]):::act
    LE_S4["結束"]:::lbl
    EN_S4(("&nbsp;")):::term
    P1["in_progress"]:::act
    P2["resolved"]:::act
    P3["wontfix"]:::act
  end
  subgraph ROLE2["使用者（長輩或家屬）"]
    LS_U1["開始"]:::lbl
    ST_U1(("&nbsp;")):::term
    U1(["送出 BUG 回報<br/>status = new"]):::act
    DB[("bug_report<br/>reporter_type / reporter_id VARCHAR<br/>★ 刻意不設外鍵")]:::gap
  end
  subgraph FE["uban-admin · BugReportsPage"]
    A1["顯示回報清單"]:::act
    A2["填寫 admin_note"]:::act
  end
  subgraph BE["uban-api · /api/admin"]
    G0{"require_admin_or_developer()"}:::dec
    B1["GET /bug-reports"]:::act
    B2["PATCH /bug-reports/{id}"]:::act
    B3{"狀態值在<br/>BUG_REPORT_STATUSES<br/>白名單內？"}:::dec
    B4["以 Literal 型別擋下"]:::act
    LE_B4["結束"]:::lbl
    EN_B4(("&nbsp;")):::term
    B5["更新 status ・admin_note<br/>handled_by_staff_id = -dev_id"]:::act
    X(["401"]):::act
    LE_X["結束"]:::lbl
    EN_X(("&nbsp;")):::term
  end

  LS_S1 ~~~ ST_S1
  ST_S1 --> S1
  LS_U1 ~~~ ST_U1
  ST_U1 --> U1
  U1 --> DB
  S1 --> G0
  G0 -->|"[否]"| X
  G0 -->|"[是]"| B1
  B1 --> DB
  DB --> A1
  A1 --> S2
  S2 --> S3
  S3 -->|"[開始處理]"| P1
  S3 -->|"[已修復]"| P2
  S3 -->|"[不予處理]"| P3
  P1 --> A2
  P2 --> A2
  P3 --> A2
  A2 --> B2
  B2 --> B3
  B3 -->|"[否]"| B4
  B3 -->|"[是]"| B5
  B5 --> DB
  B5 --> S4
  S4 --> EN_S4
  LE_S4 ~~~ EN_S4
  B4 --> EN_B4
  LE_B4 ~~~ EN_B4
  X --> EN_X
  LE_X ~~~ EN_X
  %% 鎖住泳道順序：ELK 不照宣告順序排，沒有這條鏈後端會跑到最上面
  ROLE ~~~ ROLE2 ~~~ FE ~~~ BE

  classDef act  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
  classDef dec  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
  classDef term fill:#000000,stroke:#000000,stroke-width:3px,color:#000000
  classDef gap  fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000,stroke-dasharray:4 3
  classDef lbl  fill:none,stroke:none,color:#000000
