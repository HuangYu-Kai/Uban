  subgraph FE["長輩機 App"]
    P1["pedometer StepCount 串流"]:::act
    P2["geolocator GPS 軌跡<br/>Kalman 濾波"]:::act
    P3["兩者取最大值"]:::act
    A1["PetStudioScreen 寵物花園畫面"]:::act
    A2["顯示成長階段門檻<br/>與賽季剩餘天數"]:::act
    EN_A2(("●")):::endterm
    A3["顯示好友體重排名"]:::act
    EN_A3(("●")):::endterm
    A4{"已解鎖<br/>果實？"}:::dec
    A5["餵食動畫<br/>體重增加"]:::act
    A6["提示所需步數<br/>按鈕停用"]:::act
    EN_A6(("●")):::endterm
  end
  subgraph BE["uban-api 後端"]
    PAD_BE["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]:::pad
    B1["update_steps 上傳今日步數"]:::act
    B2["thresholds 查詢五階成長門檻<br/>season 查詢目前賽季資訊"]:::act
    B3["leaderboard 查詢小豬體重排行榜"]:::act
    B4["food-unlocks 查詢今日解鎖進度（步數・服藥・運動）"]:::act
