    D1[("elder_profile.step_total 本輪累計步數<br/>elder_daily_step 逐日步數歷史")]:::act
    D2[("elder_pet_state.weight_grams<br/>體重制，非經驗值")]:::act
    D3[("pet_stage_threshold<br/>5 階等距 20 公斤<br/>第 5 階 max 為 NULL")]:::act
    D4[("pet_season 賽季資料<br/>pet_season_settlement 名次結算")]:::act
