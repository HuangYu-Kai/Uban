%%{init:{"layout":"elk","themeVariables":{"lineColor":"#000000","textColor":"#000000","nodeTextColor":"#000000","titleColor":"#000000","fontSize":"22px"}}}%%
classDiagram
  direction TB

  class 長者檔案_參照 {
    <<外部實體・T02>>
    +String elder_id (PK)
    +String elder_name
  }

  class 使用者帳戶_參照 {
    <<外部實體・T01>>
    +int user_id (PK)
    +String user_name
  }

  class 長者交友舊版_elder_fellowship_data {
    +String requester_id (PK/FK)
    +String addressee_id (PK/FK)
    +String status
    +DateTime create_ts
  }

  class 長者好友關係_elder_friendship {
    +int id (PK)
    +String elder_id_low (FK)
    +String elder_id_high (FK)
    +String status
    +String requester_elder_id (FK)
    +DateTime created_at
  }

  class 長者動態貼文_friend_post {
    +int id (PK)
    +String author_elder_id (FK)
    +Text content
    +String image_url
    +int like_count
    +DateTime created_at
  }

  class 長者貼文留言_friend_post_comment {
    +int id (PK)
    +int post_id (FK)
    +String author_elder_id (FK)
    +Text content
    +DateTime created_at
  }

  class 長者貼文按讚_friend_post_like {
    +int id (PK)
    +int post_id (FK)
    +String elder_id (FK)
    +DateTime created_at
  }

  class 家庭圈貼文_community_posts {
    +int id (PK)
    +int family_id
    +int author_id (FK)
    +String author_name
    +String author_role
    +Text content
    +int like_count
    +DateTime created_at
  }

  class 家庭貼文留言_community_comments {
    +int id (PK)
    +int post_id (FK)
    +int author_id (FK)
    +Text message
    +DateTime created_at
  }

  class 家庭貼文按讚_community_post_likes {
    +int id (PK)
    +int post_id (FK)
    +int user_id (FK)
    +DateTime created_at
  }

  class 家屬交友代碼_family_friend_code {
    +int family_id (PK/FK)
    +String family_code
    +DateTime created_at
  }

  class 家屬好友關係_family_friendship {
    +int id (PK)
    +int family_id_low (FK)
    +int family_id_high (FK)
    +String status
    +int requester_family_id (FK)
  }

  class 家屬朋友圈貼文_family_friend_post {
    +int id (PK)
    +int author_family_id (FK)
    +Text content
    +int like_count
    +DateTime created_at
  }

  class 家屬貼文留言_family_friend_post_comment {
    +int id (PK)
    +int post_id (FK)
    +int author_family_id (FK)
    +Text content
    +DateTime created_at
  }

  class 家屬貼文按讚_family_friend_post_like {
    +int id (PK)
    +int post_id (FK)
    +int family_id (FK)
    +DateTime created_at
  }

