flowchart TD
  subgraph ROLE["長輩 A（發起方）"]
    LS_S1["開始"]:::lbl
    ST_S1(("&nbsp;")):::term
    S1([開啟『加好友』]):::act
    S2["輸入對方 4 碼好友代碼"]:::act
    S3(["瀏覽好友動態<br/>按讚與留言"]):::act
  end
  subgraph ROLE2["長輩 B（受邀方）"]
    T1["查看好友邀請"]:::act
    T2{"是否同意？"}:::dec
    R1(["維持未成立<br/>雙方看不到彼此動態"]):::act
    LE_R1["結束"]:::lbl
    EN_R1(("&nbsp;")):::term
  end
  subgraph FE["長輩機 App"]
    A1["ElderAddFriendScreen"]:::act
    A2["ElderFriendFeedScreen"]:::act
    A3["提示『查無此人』"]:::act
    LE_A3["結束"]:::lbl
    EN_A3(("&nbsp;")):::term
  end
  subgraph BE["uban-api 後端"]
    B1["GET /api/friend/search"]:::act
    B2{"代碼存在<br/>且非本人？"}:::dec
    B3["POST /api/friend/request<br/>寫入 elder_friendship（pending）"]:::act
    B4["GET /api/friend/requests"]:::act
    B5["POST /api/friend/respond<br/>狀態改為 accepted"]:::act
    B6["GET /api/friend/feed"]:::act
    B7["POST /post/{id}/like<br/>POST /post/{id}/comment"]:::act
    DB[("elder_friendship<br/>UNIQUE(elder_id_low, elder_id_high)<br/>friend_post / _comment / _like")]:::act
  end

